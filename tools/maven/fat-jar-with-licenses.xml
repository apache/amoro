<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>jar-with-dependencies</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <files>
        <file>
            <source>${project.basedir}/../../licenses/maven/NOTICE-${project.artifactId}</source>
            <outputDirectory>META-INF</outputDirectory>
            <destName>NOTICE</destName>
        </file>
        <file>
            <source>${project.basedir}/../../licenses/maven/LICENSE-${project.artifactId}</source>
            <outputDirectory>META-INF</outputDirectory>
            <destName>LICENSE</destName>
        </file>
        <file>
            <source>${project.basedir}/../../licenses/maven/README-fat-jar</source>
            <outputDirectory>META-INF</outputDirectory>
            <destName>README-LICENSES</destName>
        </file>
        <file>
            <source>${project.basedir}/../../licenses-binary/LICENSE.CC-BY-2.5.html</source>
            <outputDirectory>META-INF</outputDirectory>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/../../licenses/maven/fat-jar</directory>
            <outputDirectory>META-INF/licenses</outputDirectory>
        </fileSet>
    </fileSets>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <unpackOptions>
                <excludes>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/NOTICE</exclude>
                </excludes>
            </unpackOptions>
            <scope>runtime</scope>
        </dependencySet>
        <dependencySet>
            <outputDirectory>META-INF/dependency-notices/${artifact.groupId}/${artifact.artifactId}/${artifact.version}</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
            <unpackOptions>
                <includes>
                    <include>**/*LICENSE*</include>
                    <include>**/*license*</include>
                    <include>**/*NOTICE*</include>
                    <include>**/*notice*</include>
                    <include>**/*COPYING*</include>
                </includes>
            </unpackOptions>
        </dependencySet>
    </dependencySets>
</assembly>
